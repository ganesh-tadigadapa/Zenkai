# ---------------------------------------------------------------------------
# Zenkai environment. Copy to backend/.env and frontend/.env.local as noted.
# Never commit a filled-in .env.
# ---------------------------------------------------------------------------

# === Backend (backend/.env) ===============================================

ENV=development
DEBUG=true

# PostgreSQL (recommended):
#   DATABASE_URL=postgresql+psycopg://studentos:studentos@localhost:5432/studentos
# SQLite (default — zero setup, used when this is unset):
DATABASE_URL=sqlite:///./studentos.db

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Service-account secret for /api/v1/admin/* — for scripts and CI that have no
# session. People authorise through their own account's is_admin flag instead.
# CHANGE THIS outside local development.
ADMIN_TOKEN=dev-admin-token

# Seeded demo accounts. CHANGE BOTH PASSWORDS before any public deployment —
# these defaults are published in the README.
DEMO_USER_EMAIL=student@zenkai.dev
DEMO_USER_PASSWORD=zenkai-demo-2026
DEMO_ADMIN_EMAIL=reviewer@zenkai.dev
DEMO_ADMIN_PASSWORD=zenkai-review-2026

# When true, a request with no session resolves to the demo student.
# Defaults to on in development and off everywhere else. Leave it unset.
# ALLOW_DEMO_FALLBACK=false

# LLM provider for the extraction pipeline.
# "stub" is heuristic-only and needs no key; it is the default.
AI_PROVIDER=stub
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# === Frontend (frontend/.env.local) =======================================

# Base URL of the backend API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Service-account token, sent as X-Admin-Token only when no user session exists.
# Server-side only — not exposed to the browser bundle. Must match ADMIN_TOKEN.
ZENKAI_ADMIN_TOKEN=dev-admin-token
